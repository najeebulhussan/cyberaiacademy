# =========================================================================
# CyberAI Academy - Environment Variables Configuration Template
# Copy this file to '.env' at the project root and fill in the values.
# =========================================================================

# 1. Google Gemini API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cisco NetAcad LTI 1.3 Keys (For secure sandbox integrations)
EXPO_PUBLIC_NETACAD_LTI_CLIENT_ID=your_lti_client_id
EXPO_PUBLIC_NETACAD_LTI_DEPLOYMENT_ID=dep-cyberai-01
EXPO_PUBLIC_NETACAD_LTI_OAUTH2_TOKEN_URL=https://api.netacad.com/v1.1/oauth/token
EXPO_PUBLIC_NETACAD_LTI_PLATFORM_KEYSET_URL=https://api.netacad.com/lti/keysets
